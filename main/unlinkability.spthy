theory E_Prescription_Protocol_Observational_Equivalence_Mode
begin

builtins: signing

functions:
  Enc/3,          //  Enc(mpk, AP, R)      : challenge encryption
  Dec/3,          //  Dec(sk, cipher, AP)  : challenge decryption
  KeyGen/3,       //  KeyGen(msk, S, rand) : credential issued by authority
  mpkOf/1,
  PolicyGen/1,
  RequestGen/1,
  DataGen/1

// FIX (A): KEM-shaped, subterm-convergent, no repeated compound subterm.
// A key issued under msk opens ciphertexts made under mpkOf(msk).
// (Compare: kemdecaps(alg, kemencaps(alg, kemss(alg,seed), kempk(alg,sk)), sk)
//           = kemss(alg,seed) in the KEMTLS Tamarin models.)
equations:
  Dec(
    KeyGen(msk, S, fix_randomness),
    Enc(mpkOf(msk), PolicyGen(RequestGen(S)), R),
    PolicyGen(RequestGen(S))
  ) = R

/* ================================================================
   RESTRICTIONS 
   ================================================================ */

restriction Equality:
  "All x y #i. Eq(x,y) @ #i ==> x = y"

// Single authority (the Setup() action is emitted by Authority_Setup).
restriction Single_Setup:
  "All #i #j. Setup() @ #i & Setup() @ #j ==> #i = #j"

// restriction Single_Patient_Registry:   // Only one patient registered 
//   "All #i #j. Patient_Registry() @ #i & Patient_Registry() @ #j ==> #i = #j"

restriction Single_Physician_Registry: // Only one physician registered
  "All #i #j. Physician_Registry() @ #i & Physician_Registry() @ #j ==> #i = #j"

restriction Single_Pharmacy_Registry:  // Only one pharmacy registered
  "All #i #j. Pharmacy_Registry() @ #i & Pharmacy_Registry() @ #j ==> #i = #j"


/* ==========================================================================
   Secure channel (reference points K and R).
   Replay-safe since Out_Secure / In_Secure are linear.
   ========================================================================== */
rule Chan_Secure:
    [ Out_Secure(A, B, msg) ]
  --[ Sent(A, B, msg) ]->
    [ In_Secure(A, B, msg) ]

/* ==========================================================================
   Phase 0 - Initialization
   ========================================================================== */
rule Authority_Setup:
    let
      mpk = mpkOf(~msk)
    in
    [ Fr(~msk) ]
  --[ Setup() ]->
    [ !Authority_MSK($MA, ~msk)
    , !Authority_MPK($MA, mpk)
    , Out(<'Med_Authority', $MA, mpk>)
    ]

rule Physician_Register:
    let
      physician_pk = pk(~ltk)
    in
    [ Fr(~ltk)
    , !Authority_MPK(MA, mpk)
    ]
  --[ Physician_Registry()
    ]->
    [ !PhysicianLtk($Physician, ~ltk)
    , !Physician_pk($Physician, physician_pk)
    , Out(<'Physician', $Physician, pk(~ltk)>)
    ]

rule Pharmacy_Register:
    [ Fr(~ID_pharmacy)
    , !Authority_MPK(MA, mpk)
    , !Physician_pk(Physician, physician_pk)
    ]
  --[ Pharmacy_Registry()
    ]->
    [ !Pharmacy($Pharmacy, ~ID_pharmacy), Out(<'Pharmacy', $Pharmacy, ~ID_pharmacy>) ]

rule Patients_Register:
    let
      ID_patient = diff(~ID_patient_1, ~ID_patient_2) 
    in
    [ Fr(~ID_patient_1)
    , Fr(~ID_patient_2)
    , !Authority_MPK(MA, mpk)
    , !Physician_pk(Physician, physician_pk)
    , !Pharmacy(Pharmacy, ID_pharmacy)
    ]
  --[ Patient_Registry()
    ]->
    [ !Patient($Patient, ID_patient) ]  // Patient is registered in secrecy: ID is not revealed

/* ==========================================================================
   Phase 1 - Prescription request
   ========================================================================== */
rule Patient_Physician_Request[role="Patient"]: // Patient goes to the physician to mint a prescription for his illness
    let
      req = <'Illness_req', Patient, ID_patient, ~Illness>
    in
    [ !Patient(Patient, ID_patient)
    , !Physician_pk(Physician, physician_pk)
    , Fr(~Illness)
    ]
  --[ ]->
    [ Out_Secure(Patient, Physician, req) ]

rule Physician_Request[role="Physician"]: // The physician sends the request to the medical authority
    let
      req = <'presc_req', Patient, ID_patient, ~S>
    in
    [ !Authority_MPK(MA, mpk)
    , !Patient(Patient, ID_patient)
    , !Physician_pk(Physician, physician_pk)
    , In_Secure(Patient, Physician, <'Illness_req', Patient, ID_patient, illness>)
    , Fr(~S)  // In reality this is a function of the illness, but we model it as a free variable.
    ]
  --[ ]->
    [ Out_Secure(Physician, MA, req) ]

/* ==========================================================================
   Phase 2 - Credential issuance
   The request is parsed by pattern matching on the tagged tuple.
   ========================================================================== */
rule Authority_Issue[role="Authority"]: // The authority issues the credentials and mint the secret key of the patient
    let
      ABE_sk = KeyGen(msk, S, diff(~randomness_1, ~randomness_2))
    in
    [ !Authority_MSK(MA, msk)  // Authority holds msk
    , !Physician_pk(Physician, physician_pk)
    , !Patient(Patient, ID_patient)
    , In_Secure(Physician, MA, <'presc_req', Patient, ID_patient, S>)
    , Fr(~randomness_1)
    , Fr(~randomness_2)
    ]
  --[ ]->
    [ Out_Secure(MA, Patient, <'credential', ABE_sk, ID_patient, S>) ]

rule Patient_stores_credential[role="Patient"]: // Patient receives and stores the credential (A4: protected storage).
    [ !Authority_MPK(MA, mpk)
    , !Patient(Patient, ID_patient)
    , In_Secure(MA, Patient, <'credential', ABE_sk, ID_patient, S>)
    ]
  --[ ]->
    [ !Patient_Cred(Patient, ABE_sk, ID_patient, S) ]

/* ==========================================================================
   ETSI Handshake protocol
   ========================================================================== */
rule Patient_Handshake_request[role="Patient"]: // The patient initiates the handshake
    let req = RequestGen(S) in
    [ !Patient_Cred(Patient, ABE_sk, ID_patient, S)
    , !Authority_MPK(MA, mpk)
    , !Pharmacy(Pharmacy, ID_pharmacy)
    ]
  --[ ]->
    // If an attacker can modify the request in some way in order to obtain ID_patient, then a dishonest pharmacy can learn the patient 
    // identifier without the patient explicitly revealing it.

    // In this model attacker and pharmacy are the same person, so the
    // pharmacy could modify the request in order to gain information on the
    // Patient ID during the handshake.
    [ Out(<'hs_req', Patient, Pharmacy, req>)
    , St_Patient_Wait(Patient, Pharmacy)   // linear session state (memory of the request)
    ]

rule Dishonest_Patient_Handshake_request[role="Dishonest_Patient"]: // A dishonest patient initiates the handshake with the same request of the honest one
    let
      req = RequestGen(diff(~Dishonest_S1, ~Dishonest_S2))
    in
    [ Fr(~Dishonest_S1)
    , Fr(~Dishonest_S2)
    , !Pharmacy(Pharmacy, ID_pharmacy)
    , !Patient(Dishonest_patient, ID_dis_patient)
    ]
    --[]->
    [
      Out(<'hs_req', Dishonest_patient, Pharmacy, req>)
    ]

rule Pharmacy_Computes_and_sends_Challenge[role="Pharmacy"]: // The pharmacy computes the challenge and sends it to the patient
    let
      AP        = PolicyGen(req)
      data      = DataGen(req)
      cipher    = Enc(mpk, AP, ~R)
      challenge = <cipher, AP>
    in
    [ !Authority_MPK(MA, mpk)
    , !Pharmacy(Pharmacy, ID_pharmacy)
    , In(<'hs_req', Patient, Pharmacy, req>)
    , Fr(~R)    // R = r_chosen || K_chosen
    ]
  --[
    ]->
    [ Out(<'challenge', cipher, AP>) // We output in also in a non secure challenge in order let the adversary know the ciphertext
    , St_Pharmacy_Wait(Pharmacy, Patient, ~R, cipher, AP, data)
    ]

/* --------------------------------------------------------------------------
   FIX (B): decryption of the challenge by the HONEST patient is done by
   PATTERN MATCHING instead of applying Dec under the old nested equation.

   The premise only matches
        In(<'challenge', Enc(mpk, AP, Resp), AP>)
   with AP = PolicyGen(RequestGen(ABE_sk)) for the patient's OWN credential
   and mpk the (unique) authority master public key. Binding Resp through
   the Enc pattern IS the decryption, and it simultaneously realises the
   original re-encryption test  Eq(Enc(mpk,AP,Resp), cipher)  by
   construction. If the (dishonest) verifier sends a challenge under a
   different mpk or a policy that does not match the patient's request,
   the rule cannot fire: the honest patient aborts, exactly as before.

   The Dec function and its equation remain in the theory purely as an
   ADVERSARY capability: the curious pharmacy that obtains a revealed
   credential can still open ciphertexts on its own.
   -------------------------------------------------------------------------- */
rule Patient_Decrypts_Response_and_sends_to_Pharmacy[role="Patient"]: // The patient controls if the pharmacy is honest and if so, sends the response
    let
      req          = RequestGen(S)
      AP           = PolicyGen(req)
      Resp         = Dec(ABE_sk, cipher, AP)
      cipher_prime = Enc(mpk, AP, Resp)
    in
    [ !Authority_MPK(MA, mpk)
    , !Patient_Cred(Patient, ABE_sk, ID_patient, S)
    , In(<'challenge', cipher, AP>)
    , St_Patient_Wait(Patient, Pharmacy)
    ]
  --[ Eq(cipher, cipher_prime)
    ]->
    // Here we consider the pharmacy to be honest in handling the response,
    // so we output it on a secure channel; on the other hand, since the
    // pharmacy is curious and pharmacy corresponds to the attacker, we also
    // send it via Out.
    [ Out_Secure(Patient, Pharmacy, <'response', Resp>)  // Response
    ]

rule Pharmacy_checks_Response_and_sends_Data[role="Pharmacy"]: // The pharmacy verifies if the response is valid and sends the medicine (data) to the patient
    [ In_Secure(Patient, Pharmacy, <'response', Resp>)
    , St_Pharmacy_Wait(Pharmacy, Patient, R, cipher, AP, data)
    ]
  --[ Eq(Resp, R) 
    ]->
    [ Out_Secure(Pharmacy, Patient, <'data', data>)
    ]
  
/* ==========================================================================
   Explicit, voluntary identity disclosure by the patient.
   This is the ONLY rule that puts ID_patient on the wire.
   ========================================================================== */
// rule Reveal_sk_patient:
//     [ !Patient_Cred(Patient, ABE_sk, ID_patient, S) ]
//   --[ Sk_Patient_Revealed(ABE_sk, ID_patient) ]->
//     [ Out(<ABE_sk, ID_patient>) ]

// ===========================================
// Sanity lemmas (executability)
// ===========================================
// Important: after changing the theory / patterns, ALWAYS re-check that the
// protocol can still run end-to-end, otherwise all-traces lemmas may hold
// vacuously.

end